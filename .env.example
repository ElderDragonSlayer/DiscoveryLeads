# Copie para .env e preencha. O .env NUNCA vai para o git.

# Google Cloud — Places API (New) e PageSpeed Insights.
# A mesma chave serve para as duas se ambas estiverem habilitadas no projeto.
GOOGLE_API_KEY=

# Apify — só necessário a partir da etapa E8 (link da bio do Instagram).
APIFY_TOKEN=

# Freio de segurança: teto de chamadas pagas por execução.
MAX_CHAMADAS_PLACES=100
